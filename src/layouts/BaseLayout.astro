---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Mateus — Desenvolvedor web', description = 'Portfólio de Mateus. Projetos, ideias e experiências com desenvolvimento web.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131210" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/images/mateus-bezerra-logo.png" />
    <title>{title}</title>

  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
