---
import type { projects } from '../data/portfolio';
interface Props { project: (typeof projects)[number]; }
const { project } = Astro.props;
const image = project.visual === 'aqua' ? '/images/aquamonitor-dashboard.png' : project.visual === 'kmirra' ? '/images/kmirra-preview.png' : '';
---
<article id={`project-${project.id}`} class="featured-project" data-project={project.id} data-category={project.category} hidden={project.number !== '01'} aria-labelledby={`title-${project.id}`}>
  <div class="feature-copy">
    <p class="feature-index">{project.number} / <span>{project.type}</span></p>
    <h3 id={`title-${project.id}`}>{project.visual === 'aqua' ? <>Aqua<span>Monitor</span></> : project.title}</h3>
    <p class="feature-description">{project.description}</p>
    <ul class="feature-tags" aria-label="Tecnologias">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    <div class="feature-actions">
      {project.url && <a class="feature-button primary" href={project.url} target="_blank" rel="noopener noreferrer">Ver projeto <span aria-hidden="true">↗</span></a>}
      {project.source && <a class="feature-button primary" href={project.source} target="_blank" rel="noopener noreferrer">Ver código <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
  <div class="feature-visual">
    <div class="feature-laptop">
      <div class="feature-screen">
        {image ? <img src={image} alt={`Interface do ${project.title}`} width="1265" height="712" loading={project.number === '01' ? 'eager' : 'lazy'} /> : <div class="feature-concept"><span>FORMA — EXPERIMENTO DIGITAL</span><p>Explorar é<br /><em>dar forma.</em></p><div class="sculpture" aria-hidden="true"><i></i><i></i><i></i></div></div>}
      </div>
      <div class="feature-laptop-base" aria-hidden="true"></div>
    </div>
  </div>
</article>
